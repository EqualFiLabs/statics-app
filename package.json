{
  "name": "statics-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:connected": "node scripts/dev-connected.mjs",
    "dev:preview": "NEXT_PUBLIC_APP_ENV=development NEXT_PUBLIC_DAPP_PREVIEW=true next dev",
    "build:preview": "NEXT_PUBLIC_APP_ENV=development NEXT_PUBLIC_DAPP_PREVIEW=true next build",
    "config:privy:local": "node scripts/import-local-privy.mjs",
    "deploy:protocol:local": "node scripts/deploy-local-dollar.mjs",
    "deploy:dollar:local": "node scripts/deploy-local-dollar.mjs",
    "local:status": "node scripts/local-control.mjs status",
    "local:fund-wallet": "node scripts/local-control.mjs fund-wallet",
    "local:advance": "node scripts/local-control.mjs advance",
    "local:generate-rewards": "node scripts/local-control.mjs generate-rewards",
    "local:generate-lp-fees": "node scripts/local-control.mjs generate-lp-fees",
    "local:seed-recovery": "node scripts/local-control.mjs seed-recovery",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sdk:sync": "node scripts/vendor-statics-sdk.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:preview && playwright test",
    "verify:connected:local": "node scripts/verify-connected-local.mjs",
    "test:integration:local": "node test/integration/local-dollar.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.35.1",
    "@privy-io/wagmi": "4.0.14",
    "@solana-program/memo": "^0.8.0",
    "@solana/web3.js": "^1.98.4",
    "@statics-protocol/sdk": "file:vendor/statics-sdk",
    "@tanstack/react-query": "5.101.4",
    "buffer": "^6.0.3",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.52.0",
    "wagmi": "3.7.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.61.1",
    "@scure/bip39": "1.6.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "axios": "1.18.1",
    "postcss": "8.5.22",
    "sharp": "0.35.0",
    "ws": "8.21.1"
  }
}
