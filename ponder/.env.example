# Run one deployment per process and database schema.
PONDER_DEPLOYMENT_ID=robinhood-testnet-protocol
PONDER_CHAIN_ID=46630
PONDER_DEPLOYMENT_START_BLOCK=
# Use an authenticated provider application/key dedicated to Ponder. Do not share its quota with
# the app's STATICS_ROBINHOOD_* same-origin read proxy.
PONDER_RPC_URL_46630=
PONDER_RPC_URL_4663=
PONDER_RPC_URL_31337=http://127.0.0.1:8546

# Full protocol deployment. These sources may run beside the launch sources after handoff.
PONDER_STATICS_DIAMOND_ADDRESS=
PONDER_POSITION_MANAGER_ADDRESS=
PONDER_STATICS_START_BLOCK=
PONDER_POSITION_MANAGER_START_BLOCK=
PONDER_MORPHO_ADDRESS=
PONDER_MORPHO_START_BLOCK=

# Genesis collection exists in both stages.
PONDER_STATICS_GENESIS_ADDRESS=
PONDER_STATICS_GENESIS_START_BLOCK=

# Genesis launch contracts. Keep them configured after handoff to preserve launch history.
PONDER_GENESIS_VAULT_ADDRESS=
PONDER_GENESIS_ACTIVATION_REGISTRY_ADDRESS=
PONDER_GENESIS_LAUNCH_DISTRIBUTOR_ADDRESS=
PONDER_STATICS_FEE_RECEIVER_ADDRESS=
PONDER_POOL_MANAGER_ADDRESS=
PONDER_CANONICAL_POOL_ID=
PONDER_GENESIS_VAULT_START_BLOCK=
PONDER_GENESIS_ACTIVATION_START_BLOCK=
PONDER_GENESIS_DISTRIBUTOR_START_BLOCK=
PONDER_STATICS_FEE_RECEIVER_START_BLOCK=
PONDER_POOL_MANAGER_START_BLOCK=

PONDER_ALLOWED_ORIGIN=http://localhost:3000
DATABASE_URL=
DATABASE_SCHEMA=
# Optional isolated PGlite directory used by the one-command launch fork.
PONDER_DATABASE_DIRECTORY=
