NEXT_PUBLIC_APP_ENV=development
# Required only when NEXT_PUBLIC_APP_ENV=production.
NEXT_PUBLIC_SITE_URL=
# Use the same public Privy App ID as Eves Market. Each app keeps its own login session.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional when the Privy application requires a client ID.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Server-only Uniswap Trading API credentials. Leave both fee values empty for zero fee.
UNISWAP_API_KEY=
UNISWAP_INTEGRATOR_FEE_RECIPIENT=
UNISWAP_INTEGRATOR_FEE_BIPS=
# Optional server-only Jupiter API credential.
JUPITER_API_KEY=
# Server-only Across Swap API credentials. Integrator ID is a 2-byte hex value such as 0xdead.
ACROSS_API_KEY=
ACROSS_INTEGRATOR_ID=
# Server-only RPCs used to verify LayerZero EVE destination receipts.
EVE_BASE_RPC_URL=
EVE_ROBINHOOD_RPC_URL=

# robinhood-testnet is the default. anvil is accepted only in development.
NEXT_PUBLIC_APP_NETWORK=robinhood-testnet
# Development may use the public fallback. Staging and production must configure a dedicated URL.
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
# Required for a reviewed Robinhood mainnet configuration outside development.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
# Optional local override used only when NEXT_PUBLIC_APP_ENV=development.
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
# Generated by `npm run dev:launch-fork`; do not configure this manifest for a public build.
NEXT_PUBLIC_STATICS_LOCAL_LAUNCH_MANIFEST=
NEXT_PUBLIC_STATICS_LOCAL_INDEXER_URL=http://127.0.0.1:42070
# Production Ponder endpoint for the standalone Robinhood mainnet Genesis launch.
NEXT_PUBLIC_STATICS_MAINNET_INDEXER_URL=
# Optional credential-free Solana mainnet RPC. Privy's public app-scoped RPC is used when omitted.
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL=

# Dollar deployment values are generated only for local Anvil by `npm run deploy:dollar:local`.
# Leave them blank for Robinhood testnet: the public build uses deployments/46630.json.
NEXT_PUBLIC_STATICS_CHAIN_ID=46630
NEXT_PUBLIC_STATICS_DEPLOYMENT_START_BLOCK=
NEXT_PUBLIC_STATICS_DIAMOND_ADDRESS=
NEXT_PUBLIC_STATICS_DOLLAR_CORE_ADDRESS=
NEXT_PUBLIC_STATICS_DOLLAR_GATEWAY_ADDRESS=
NEXT_PUBLIC_STATICS_DOLLAR_TOKEN_ADDRESS=
NEXT_PUBLIC_STATICS_DOLLAR_RISK_ADDRESS=
NEXT_PUBLIC_STATICS_WETH_ADDRESS=
NEXT_PUBLIC_STATICS_DOLLAR_ORACLE_ADDRESS=
NEXT_PUBLIC_STATICS_WETH_PROFILE_ID=
NEXT_PUBLIC_STATICS_USDG_ADDRESS=
NEXT_PUBLIC_STATICS_USDG_ORACLE_ADDRESS=
NEXT_PUBLIC_STATICS_USDG_PROFILE_ID=
NEXT_PUBLIC_STATICS_USDG_CODE_HASH=
NEXT_PUBLIC_STATICS_USDG_ORACLE_CODE_HASH=
NEXT_PUBLIC_STATICS_PROTOCOL_COMMIT=
NEXT_PUBLIC_STATICS_DIAMOND_CODE_HASH=
NEXT_PUBLIC_STATICS_DOLLAR_CORE_CODE_HASH=
NEXT_PUBLIC_STATICS_DOLLAR_GATEWAY_CODE_HASH=
NEXT_PUBLIC_STATICS_DOLLAR_TOKEN_CODE_HASH=
NEXT_PUBLIC_STATICS_DOLLAR_RISK_CODE_HASH=
NEXT_PUBLIC_STATICS_WETH_CODE_HASH=
NEXT_PUBLIC_STATICS_DOLLAR_ORACLE_CODE_HASH=
NEXT_PUBLIC_STATICS_TOKEN_ADDRESS=
NEXT_PUBLIC_STATICS_GENESIS_NFT_ADDRESS=
NEXT_PUBLIC_STATICS_GENESIS_RENDERER_ADDRESS=
NEXT_PUBLIC_STATICS_AVATAR_SVG_ADDRESS=
NEXT_PUBLIC_STATICS_TOKEN_CODE_HASH=
NEXT_PUBLIC_STATICS_GENESIS_NFT_CODE_HASH=
NEXT_PUBLIC_STATICS_GENESIS_RENDERER_CODE_HASH=
NEXT_PUBLIC_STATICS_AVATAR_SVG_CODE_HASH=
NEXT_PUBLIC_STATICS_POOL_MANAGER_ADDRESS=
NEXT_PUBLIC_STATICS_POSITION_MANAGER_ADDRESS=
NEXT_PUBLIC_STATICS_PERMIT2_ADDRESS=
NEXT_PUBLIC_STATICS_SWAP_FEE_HOOK_ADDRESS=
NEXT_PUBLIC_STATICS_LIQUIDITY_MANAGER_ADDRESS=
NEXT_PUBLIC_STATICS_STATE_VIEW_ADDRESS=
NEXT_PUBLIC_STATICS_POOL_MANAGER_CODE_HASH=
NEXT_PUBLIC_STATICS_POSITION_MANAGER_CODE_HASH=
NEXT_PUBLIC_STATICS_PERMIT2_CODE_HASH=
NEXT_PUBLIC_STATICS_SWAP_FEE_HOOK_CODE_HASH=
NEXT_PUBLIC_STATICS_LIQUIDITY_MANAGER_CODE_HASH=
NEXT_PUBLIC_STATICS_STATE_VIEW_CODE_HASH=
# Optional Ponder endpoint for recoverable loans and external v4 NFT discovery.
NEXT_PUBLIC_STATICS_INDEXER_URL=

# Optional validated handoff. When absent, the Eves link is visibly disabled.
NEXT_PUBLIC_EVES_MARKET_URL=
